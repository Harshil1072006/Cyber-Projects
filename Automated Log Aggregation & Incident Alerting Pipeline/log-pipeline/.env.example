# Slack webhook for error rate alerts (optional but recommended)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Alerter tuning (override defaults)
ALERT_THRESHOLD=20       # flat error count per CHECK_WINDOW_MIN
SPIKE_MULTIPLIER=3.0     # spike ratio vs baseline
CHECK_WINDOW_MIN=5       # rolling window in minutes
CHECK_INTERVAL=60        # seconds between checks

# Elasticsearch
ES_HOST=http://elasticsearch:9200
ES_INDEX_PATTERN=logs-*
