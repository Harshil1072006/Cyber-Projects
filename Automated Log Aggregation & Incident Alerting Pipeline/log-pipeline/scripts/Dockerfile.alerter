FROM python:3.12-slim

LABEL description="Error rate alerter for ELK log pipeline"

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY error_rate_alerter.py .

RUN useradd --system --uid 1000 --no-create-home alerter
USER alerter

ENTRYPOINT ["python", "error_rate_alerter.py"]
