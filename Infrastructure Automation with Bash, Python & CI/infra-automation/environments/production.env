# ─────────────────────────────────────────────────────────────────────────────
#  environments/production.env — Production environment configuration
#  ALL secrets must be injected via GitHub Secrets / environment variables.
#  Never commit real credentials to this file.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=app-server
APP_VERSION=0.0.0
APP_ENV=production
APP_PORT=8080
APP_HEALTH_PATH=/health
APP_LOG_LEVEL=info

# Deployment
DEPLOY_USER=deploy
DEPLOY_DIR=/var/lib/app
DEPLOY_BACKUP_DIR=/var/backups/app
ARTIFACT_URL=

# Target host
TARGET_HOST=localhost
SSH_KEY_PATH=
MAX_DEPLOY_RETRIES=3
HEALTH_CHECK_TIMEOUT=60

# Secrets — injected at runtime via GitHub Secrets
# In CI: SECRET_KEY is set from ${{ secrets.PROD_SECRET_KEY }}
SECRET_KEY=production-secret-key-replace-with-32-char-secret
DATABASE_URL=
REDIS_URL=

# Notifications
SLACK_WEBHOOK_URL=
