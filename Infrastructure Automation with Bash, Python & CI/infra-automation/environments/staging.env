# ─────────────────────────────────────────────────────────────────────────────
#  environments/staging.env — Staging environment configuration
#  Validated by config_validator.py before every deploy.
#  DO NOT commit secrets here — use GitHub Secrets or a secrets manager.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=app-server
APP_VERSION=0.0.0
APP_ENV=staging
APP_PORT=8080
APP_HEALTH_PATH=/health
APP_LOG_LEVEL=debug

# Deployment
DEPLOY_USER=deploy
DEPLOY_DIR=/var/lib/app
DEPLOY_BACKUP_DIR=/var/backups/app
ARTIFACT_URL=

# Target host (Docker container name in CI, real hostname in production)
TARGET_HOST=localhost
SSH_KEY_PATH=
MAX_DEPLOY_RETRIES=3
HEALTH_CHECK_TIMEOUT=30

# Secrets (override via environment variables in CI — never commit real values)
SECRET_KEY=staging-secret-key-replace-me-with-32chars
DATABASE_URL=
REDIS_URL=

# Notifications
SLACK_WEBHOOK_URL=
