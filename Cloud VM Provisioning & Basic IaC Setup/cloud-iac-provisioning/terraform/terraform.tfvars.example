# Example configuration for the project
# Copy this file to `terraform.tfvars` (which is gitignored) and replace with your values.

# aws_region = "us-east-1"
# environment = "dev"
# project_name = "sre-iac-demo"
# instance_type = "t3.micro"

# Replace with your actual IP CIDR to allow SSH access. DO NOT use 0.0.0.0/0.
# allowed_ssh_cidr = "203.0.113.1/32"
